NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_CLINIC_ID=replace-with-clinic-id-from-seed-output

# Firebase (Spark plan) — project: mawid-app-d1d03. See docs/firebase-setup.md.
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup
# has the exact values (register a Web app there first if you haven't).
# These are the public Web SDK config values, safe to ship client-side —
# access control lives in firestore.rules, not in hiding these.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mawid-app-d1d03.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mawid-app-d1d03
# storageBucket's domain suffix depends on when the project was created
# (.appspot.com for older projects, .firebasestorage.app for newer ones) —
# copy the exact value from the console rather than guessing.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The email /signup routes to a sign-in attempt instead of the clinic
# signup flow (see lib/firebase/auth.ts isConfiguredAdminEmail). This is a
# UX hint only, not a security boundary — real admin access is always
# gated by the custom claim set via scripts/seed-admin.mjs.
NEXT_PUBLIC_ADMIN_EMAIL=
