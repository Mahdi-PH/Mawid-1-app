NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_CLINIC_ID=replace-with-clinic-id-from-seed-output

# Firebase (Spark plan) — see docs/firebase-setup.md.
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup.
# These are the public Web SDK config values, safe to ship client-side —
# access control lives in firestore.rules, not in hiding these.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
