# ─────────────────────────────────────────────────────────────
# DUSKFRONT — نموذج متغيرات البيئة / environment template
# انسخه إلى .env :  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- قاعدة البيانات / Database -------------------------------
# اتركه فارغًا لتشغيل الخادم بمخزن داخل الذاكرة (بدون Postgres)
# Leave empty to run the server on the in-memory store (no Postgres needed)
DATABASE_URL=postgresql://duskfront:duskfront@localhost:5432/duskfront?schema=public
POSTGRES_USER=duskfront
POSTGRES_PASSWORD=duskfront
POSTGRES_DB=duskfront

# --- Redis (جلسات، مطابقة، لوحة صدارة) -----------------------
# اتركه فارغًا للعمل بمخزن داخل الذاكرة / empty = in-memory fallback
REDIS_URL=redis://localhost:6379

# --- المصادقة / Auth ------------------------------------------
# غيّرها في الإنتاج! استخدم:  openssl rand -hex 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-fedcba9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- الخادم / Server ------------------------------------------
PORT=2567
HOST=0.0.0.0
NODE_ENV=development
SERVER_VERSION=1.0.0
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# --- العميل / Client (Vite) -----------------------------------
VITE_API_URL=http://localhost:2567
VITE_WS_URL=ws://localhost:2567

# --- النسخ الاحتياطي / Backups --------------------------------
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAYS=7
