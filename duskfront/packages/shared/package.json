{
  "name": "@duskfront/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./balance.json": "./src/balance.json"
  },
  "files": [
    "dist",
    "src/balance.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:balance": "node scripts/gen-balance.mjs",
    "prebuild": "node scripts/gen-balance.mjs"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
